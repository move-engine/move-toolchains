# Global workspace used when a host-specific workspace is not configured.
MOVE_TOOLCHAINS_LOCAL_ROOT=

# Host-specific workspace overrides.
MOVE_TOOLCHAINS_WIN32_X64_ROOT=
MOVE_TOOLCHAINS_LINUX_X64_ROOT=
MOVE_TOOLCHAINS_DARWIN_X64_ROOT=
MOVE_TOOLCHAINS_DARWIN_ARM64_ROOT=

# Direct component overrides. These take precedence over the workspace roots.
MOVE_CLANG_P2996_ROOT=
MOVE_GCC_ROOT=
MOVE_UCRT64_ROOT=C:\msys64\ucrt64
MOVE_XMAKE_PATH=

# Public repository that owns portable binary releases.
MOVE_TOOLCHAINS_RELEASE_REPOSITORY=
