{
  "schemaVersion": 2,
  "release": {
    "tag": "toolchains-2026.08.10",
    "title": "Move toolchains 2026.08.10",
    "notes": "Publishes three complete, profile-coherent Move toolchain sets for native Windows UCRT64, Linux glibc 2.35, and Linux glibc 2.38. Every set reuses the exact qualified Move GCC 16.2.0 move.2 artifact from 2026.08.9 and pairs it with clang-p2996 a6abb679 move.2. The clang update exports the complete public reflection API from import std, adds annotations_of_with_type compatibility, and installs the libc++ named-module sources."
  },
