{
  "schemaVersion": 2,
  "release": {
    "tag": "toolchains-2026.08.11",
    "title": "Move toolchains 2026.08.11",
    "notes": "Publishes three complete, profile-coherent Move toolchain sets for native Windows UCRT64, Linux glibc 2.35, and Linux glibc 2.38. Every set reuses the exact qualified Move GCC 16.2.0 move.2 artifact from 2026.08.9 and pairs it with clang-p2996 46faf27e move.3. The clang update completes the import std reflection surface by exporting define_static_array and define_static_string alongside std::meta."
  },
