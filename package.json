{
  "name": "move-toolchains",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node toolchains.mjs",
    "toolchains": "node toolchains.mjs",
    "gcc": "node tools/gcc.mjs",
    "doctor": "node tools/release.mjs doctor",
    "doctor:clangd": "node tools/reflection/bootstrap.mjs doctor",
    "status:clangd": "node tools/reflection/bootstrap.mjs status",
    "adopt:clangd": "node tools/reflection/bootstrap.mjs adopt --accept-prebuilt",
    "configure:clangd": "node tools/reflection/bootstrap.mjs configure",
    "install:clangd": "node tools/reflection/bootstrap.mjs install",
    "import-build:clangd": "node tools/reflection/bootstrap.mjs import-build --accept-existing-build",
    "package:clang-p2996": "node tools/package-clang-p2996.mjs",
    "package:clang-p2996:linux": "node tools/package-linux-clang-p2996.mjs",
    "ubuntu2204:clangd": "node tools/ubuntu2204.mjs",
    "test": "node --test",
    "release:verify": "node tools/release.mjs verify",
    "release:publish": "node tools/release.mjs publish",
    "verify-release": "node tools/release.mjs verify"
  }
}
