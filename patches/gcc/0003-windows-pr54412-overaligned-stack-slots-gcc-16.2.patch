diff --git a/gcc/testsuite/g++.target/i386/pr54412-anonymous-temp-2.C b/gcc/testsuite/g++.target/i386/pr54412-anonymous-temp-2.C
new file mode 100644
index 000000000..b6fc1ebd0
--- /dev/null
+++ b/gcc/testsuite/g++.target/i386/pr54412-anonymous-temp-2.C
@@ -0,0 +1,47 @@
+/* PR target/54412 */
+/* { dg-do compile { target x86_64-*-mingw* } } */
+/* { dg-options "-O2 -fno-strict-aliasing -mavx2 -masm=intel -std=gnu++17 -fno-omit-frame-pointer" } */
+/* { dg-final { scan-assembler-not {lea[ \t]+r8, 63\[rsp\]} } } */
+/* { dg-final { scan-assembler-not {and[ \t]+r8, -32} } } */
+/* { dg-final { scan-assembler-not {vmovdqa[ \t]+YMMWORD PTR \[r8\], ymm0} } } */
+
+template <typename Iterator, typename Predicate>
+__attribute__ ((noinline, noclone))
+Iterator
+find_if_inner (Iterator first, Iterator last, Predicate &predicate)
+{
+  asm volatile ("" : : "g" (first), "g" (last), "g" (&predicate)
+		: "memory");
+  return first;
+}
+
+template <typename Iterator, typename Predicate>
+__attribute__ ((noinline, noclone))
+Iterator
+find_if (Iterator first, Iterator last, Predicate predicate)
+{
+  return find_if_inner (first, last, predicate);
+}
+
+struct string_view
+{
+  int size;
+  void *data;
+};
+
+struct iterator
+{
+  int value;
+};
+
+iterator first;
+iterator last;
+string_view name;
+string_view category;
+
+void
+exercise ()
+{
+  find_if (first, last, [category = category, name = name] (iterator)
+	   { return false; });
+}
