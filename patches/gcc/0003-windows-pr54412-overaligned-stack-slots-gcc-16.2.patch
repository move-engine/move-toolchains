diff --git a/gcc/testsuite/g++.target/i386/pr54412-overaligned-byref.C b/gcc/testsuite/g++.target/i386/pr54412-overaligned-byref.C
new file mode 100644
index 000000000..b50d27007
--- /dev/null
+++ b/gcc/testsuite/g++.target/i386/pr54412-overaligned-byref.C
@@ -0,0 +1,29 @@
+/* PR target/54412 */
+/* { dg-do run { target { x86_64-*-mingw* && avx } } } */
+/* { dg-options "-O2 -mavx2 -std=gnu++17 -fno-omit-frame-pointer" } */
+
+typedef long long v4di __attribute__ ((vector_size (32), aligned (32)));
+
+struct wrapper
+{
+  v4di value;
+};
+
+__attribute__ ((noinline, noclone))
+long long
+check (wrapper value)
+{
+  if (((__UINTPTR_TYPE__) &value & 31) != 0)
+    __builtin_abort ();
+  return value.value[0] + value.value[1]
+    + value.value[2] + value.value[3];
+}
+
+int
+main ()
+{
+  wrapper value = {{ 1, 2, 3, 4 }};
+  if (((__UINTPTR_TYPE__) &value & 31) != 0)
+    __builtin_abort ();
+  return check (value) == 10 ? 0 : 1;
+}
